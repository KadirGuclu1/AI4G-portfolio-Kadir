        "formTitle": "SleepWindDown",
        "formDescription": "Evening check-in A brief, voluntary check-in during your evening. This does not constitute medical or diagnostic advice and is not a substitute for professional help. We collect only what is necessary and do not share any information with third parties.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Your email address (for your personal routine)",
              "fieldType": "email",
              "fieldName": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Screen time today (hours)",
              "fieldType": "number",
              "fieldName": "screen_time_vandaag",
              "placeholder": "bijv. 6",
              "requiredField": true
            },
            {
              "fieldLabel": "How do you feel now? (1 = low, 5 = good)",
              "fieldType": "number",
              "fieldName": "mood",
              "requiredField": true
            },
            {
              "fieldLabel": "How much stress are you experiencing right now? (1 = low, 5 = high)",
              "fieldType": "number",
              "fieldName": "stress",
              "requiredField": true
            },
            {
              "fieldLabel": "Is there anything else you'd like to share? (optional)",
              "fieldType": "textarea",
              "fieldName": "notitie"
            }
          ]
        },
        "options": {
          "path": "sleepwinddown-checkin",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thank you. Your personal wind-down routine will arrive by email shortly. Take good care of yourself."
            }
          }
        }
