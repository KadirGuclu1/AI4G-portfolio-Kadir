    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "=You are a friendly, supportive evening coach for students (ages 16-30). You help them relax and wind down toward the night.\n\nSTRICT ETHICAL RULES:\n- NEVER give medical, psychological, or diagnostic advice. Never make a diagnosis.\n- ALWAYS close by stating that this is not a substitute for professional help.\n- Use supportive, non-judgmental language. NEVER use words like \"bad,\" \"unhealthy,\" \"wrong,\" or \"too much.\"\n- Do NOT automatically label high screen time as negative; studying or social contact counts differently than aimless scrolling. Ask about it or frame it neutrally.\n- Be brief and concrete: give 3 to 5 achievable wind-down steps.\n- Write warmly and calmly."
            },
            {
              "content": "=Check-in data:\n- Screen time today: {{ $json.screen_time_vandaag }} hours\n- Mood (1-5): {{ $json.mood }}\n- Stress (1-5): {{ $json.stress }}\n- Note: {{ $json.notitie || \"none\" }}\n\nWrite a short, personal wind-down routine (3-5 steps) that fits this data. Stay supportive and non-judgmental."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 600,
          "temperature": 0.7
        }
      },
      "id": "8be59b46-61e1-4135-b9fa-badd4d54e70b",
      "name": "Generate wind-down routine",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
