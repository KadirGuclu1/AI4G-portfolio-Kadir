    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "email_body",
              "name": "email_body",
              "type": "string",
              "value": "={{ \"Hi,\\n\\nThanks for completing your check-in. Here is your personal wind-down routine for tonight:\\n\\n\" + $json.output[0].content[0].text + \"\\n\\nExtra tip: in the last half hour before sleep, try to make your screen calmer (dim it or set it aside), in whatever way feels good to you.\\n\\nThis message is meant to be supportive and is not medical or diagnostic advice. If you notice you haven't felt well for a longer time, feel free to talk about it with your GP or another professional.\\n\\nSleep well,\\nSleepWindDown\" }}"
            }
          ]
        },
        "options": {}
      },
      "id": "662df72a-b8ee-41c1-8b15-6569184853f7",
