            {
              "id": "email_body",
              "name": "email_body",
              "type": "string",
              "value": "={{ \"Hi,\\n\\nThank you for taking a moment to reflect on how you're doing. Here is a calm wind-down routine for tonight:\\n\\n\" + $json.output[0].content[0].text + \"\\n\\nIt sounds like today feels a bit heavier, and that's completely okay. Be gentle with yourself.\\n\\nIf you notice your mood stays low or the stress lingers, know that you're not alone. It can help to talk about it with someone you trust, or to contact your GP or a professional. If you are in the Netherlands you can also reach 113 Suicide Prevention (call 113 or 0800-0113, 24/7, free). If you are elsewhere, please reach out to a local helpline or emergency services.\\n\\nThis message is meant to be supportive and is explicitly not medical or diagnostic advice and not a substitute for professional help.\\n\\nTake care and sleep well,\\nSleepWindDown\" }}"
            }
          ]
        },
